/* =========================================
   EMBARGO
========================================= */

function calcularEmbargo(){

    const neto=numero("embargoNeto");

    const protegido=
        numero("referenciaProtegida");

    const deuda=
        numero("deudaPendiente");

    if(neto<=0){

        alert(
            "Introduce primero el salario neto."
        );

        return;
    }


    const exceso=
        Math.max(
            0,
            neto-protegido
        );


    /*
      Escala orientativa.

      IMPORTANTE:
      debe revisarse y actualizarse
      según la normativa aplicable.
    */

    let restante=exceso;

    let embargo=0;


    const tramos=[
        {limite:protegido,porcentaje:.30},
        {limite:protegido,porcentaje:.50},
        {limite:protegido,porcentaje:.60},
        {limite:protegido,porcentaje:.75},
        {limite:Infinity,porcentaje:.90}
    ];


    for(
        let i=0;
        i<tramos.length && restante>0;
        i++
    ){

        const cantidad=
            Math.min(
                restante,
                tramos[i].limite
            );

        embargo+=
            cantidad*
            tramos[i].porcentaje;

        restante-=cantidad;

    }


    embargo=Math.min(
        embargo,
        neto
    );


    const restanteTrabajador=
        neto-embargo;


    const resultado=
        document.getElementById(
            "resultadoEmbargo"
        );


    resultado.classList.remove("hidden");


    resultado.innerHTML=`

        <h2>🔒 Resultado orientativo</h2>

        <div class="big-result">
            ${euros(embargo)}
        </div>

        <p>
            Posible importe mensual embargable
            según los parámetros introducidos.
        </p>


        <div class="result-row">
            <span>Neto antes del embargo</span>
            <strong>${euros(neto)}</strong>
        </div>


        <div class="result-row">
            <span>Importe de referencia protegido</span>
            <strong>${euros(protegido)}</strong>
        </div>


        <div class="result-row">
            <span>Exceso sobre referencia</span>
            <strong>${euros(exceso)}</strong>
        </div>


        <div class="result-row">
            <span>Embargo estimado</span>
            <strong>${euros(embargo)}</strong>
        </div>


        <div class="result-row result-total">
            <span>Te quedarían aproximadamente</span>
            <strong>${euros(restanteTrabajador)}</strong>
        </div>


        ${
            deuda>0
            ?
            `<div class="result-row">
                <span>Deuda introducida</span>
                <strong>${euros(deuda)}</strong>
            </div>`
            :
            ""
        }


        <div class="notice">

            ⚠️ Esta es una estimación.
            La cantidad real puede variar según la resolución
            de embargo, pagas extraordinarias, conceptos computables,
            tipo de deuda y normativa vigente.

        </div>
    `;

}


/* =========================================
   FINIQUITO
========================================= */

function calcularFiniquito(){

    const salario=
        numero("salarioFiniquito");


    let salarioAnual=
        numero("salarioAnualFiniquito");


    if(
        salarioAnual<=0 &&
        salario>0
    ){

        salarioAnual=
            salario*
            12;

    }


    const diasPendientes=
        numero("diasSalarioPendiente");


    const salarioDiario=
        salario/
        30;


    const salarioPendiente=
        salarioDiario*
        diasPendientes;


    const vacacionesAnuales=
        numero("vacacionesAnuales");


    const vacacionesDisfrutadas=
        numero("vacacionesDisfrutadas");


    const vacacionesPendientes=
        Math.max(
            0,
            vacacionesAnuales-
            vacacionesDisfrutadas
        );


    const vacacionesEuros=
        vacacionesPendientes*
        salarioDiario;


    const pagasPendientes=
        numero("pagasPendientes");


    const tipo=
        document.getElementById(
            "tipoExtincion"
        ).value;


    const antiguedad=
        numero("antiguedad");


    const diasIndemnizacion=
        numero("diasIndemnizacion");


    let indemnizacion=0;


    if(
        tipo!=="finiquito" &&
        diasIndemnizacion>0 &&
        salarioAnual>0
    ){

        indemnizacion=
            (
                salarioAnual/
                365
            )*
            diasIndemnizacion*
            antiguedad;

    }


    const tope=
        numero("topeIndemnizacion");


    if(
        tope>0 &&
        indemnizacion>tope
    ){

        indemnizacion=
            tope;

    }


    const finiquito=

        salarioPendiente+
        vacacionesEuros+
        pagasPendientes;


    const total=

        finiquito+
        indemnizacion;


    const resultado=
        document.getElementById(
            "resultadoFiniquito"
        );


    resultado.classList.remove("hidden");


    resultado.innerHTML=`

        <h2>📄 Resultado estimado</h2>

        <div class="big-result">
            ${euros(total)}
        </div>

        <p class="muted">
            Finiquito + indemnización orientativa.
        </p>


        <h3>Finiquito</h3>


        <div class="result-row">
            <span>Salario pendiente</span>
            <strong>${euros(salarioPendiente)}</strong>
        </div>


        <div class="result-row">
            <span>Vacaciones pendientes</span>
            <strong>${euros(vacacionesEuros)}</strong>
        </div>


        <div class="result-row">
            <span>Pagas extra pendientes</span>
            <strong>${euros(pagasPendientes)}</strong>
        </div>


        <div class="result-row result-total">
            <span>Total finiquito</span>
            <strong>${euros(finiquito)}</strong>
        </div>


        <h3>Indemnización</h3>


        <div class="result-row">
            <span>Tipo seleccionado</span>
            <strong>${escapar(
                document.getElementById(
                    "tipoExtincion"
                ).selectedOptions[0].text
            )}</strong>
        </div>


        <div class="result-row">
            <span>Antigüedad</span>
            <strong>${antiguedad} años</strong>
        </div>


        <div class="result-row">
            <span>Días/año introducidos</span>
            <strong>${diasIndemnizacion}</strong>
        </div>


        <div class="result-row result-total">
            <span>Indemnización estimada</span>
            <strong>${euros(indemnizacion)}</strong>
        </div>


        <details>

            <summary>
                🔎 Ver cálculo
            </summary>

            <p>
                Salario diario utilizado:
                <strong>${euros(salarioDiario)}</strong>
            </p>

            <p>
                Salario pendiente:
                ${euros(salarioDiario)}
                × ${diasPendientes} días.
            </p>

            <p>
                Vacaciones:
                ${vacacionesPendientes} días
                × ${euros(salarioDiario)}.
            </p>

            <p>
                La indemnización utiliza el salario anual,
                antigüedad y número de días/año que hayas introducido.
            </p>

        </details>


        <div class="notice">

            ⚠️ <strong>Importante:</strong>
            la indemnización real no puede determinarse únicamente
            seleccionando un tipo de despido. Deben comprobarse
            las circunstancias concretas, fechas, antigüedad,
            salario regulador, límites legales y convenio aplicable.

        </div>
    `;

}


/* =========================================
   GUARDAR NÓMINA
========================================= */

function obtenerDatosNomina(){

    const datos={};

    document
    .querySelectorAll(
        "#nomina input,#nomina select"
    )
    .forEach(elemento=>{

        datos[elemento.id]=
            elemento.value;

    });


    return datos;
}


function guardarNomina(){

    const datos=
        obtenerDatosNomina();


    localStorage.setItem(
        "cuentaclaro_nomina",
        JSON.stringify(datos)
    );


    alert(
        "Tu cálculo se ha guardado en este dispositivo."
    );


    cargarGuardados();

}


function cargarGuardados(){

    const contenedor=
        document.getElementById(
            "listaGuardados"
        );


    const datos=
        localStorage.getItem(
            "cuentaclaro_nomina"
        );


    if(!datos){

        contenedor.innerHTML=`
            <p class="muted">
                Todavía no tienes cálculos guardados.
            </p>
        `;

        return;

    }


    contenedor.innerHTML=`

        <div class="card">

            <h3>
                💶 Nómina guardada
            </h3>

            <p class="muted">
                Puedes recuperar los datos de tu último cálculo.
            </p>

            <div class="actions">

                <button
                    class="btn btn-primary"
                    onclick="recuperarNomina()">

                    Recuperar cálculo

                </button>

                <button
                    class="btn btn-danger"
                    onclick="borrarDatos()">

                    Borrar

                </button>

            </div>

        </div>
    `;

}


function recuperarNomina(){

    const datos=
        JSON.parse(
            localStorage.getItem(
                "cuentaclaro_nomina"
            )
        );


    Object.entries(datos)
    .forEach(([id,valor])=>{

        const elemento=
            document.getElementById(id);

        if(elemento){
            elemento.value=valor;
        }

    });


    document
    .querySelector('[onclick^="mostrar(\'nomina\'"]')
    .click();


    calcularNomina();

}


function borrarDatos(){

    if(
        confirm(
            "¿Quieres borrar los cálculos guardados?"
        )
    ){

        localStorage.removeItem(
            "cuentaclaro_nomina"
        );

        cargarGuardados();

    }

}


/* =========================================
   EXPORTAR
========================================= */

function exportarDatos(){

    const datos=
        localStorage.getItem(
            "cuentaclaro_nomina"
        ) || "{}";


    const archivo=
        new Blob(
            [datos],
            {
                type:"application/json"
            }
        );


    const url=
        URL.createObjectURL(
            archivo
        );


    const enlace=
        document.createElement("a");


    enlace.href=url;

    enlace.download=
        "cuentaclaro-mis-datos.json";


    enlace.click();


    URL.revokeObjectURL(url);

}


