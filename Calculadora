}


/* =========================================
   UTILIDADES
========================================= */

function numero(id){

    const elemento=document.getElementById(id);

    if(!elemento) return 0;

    return parseFloat(elemento.value)||0;
}


function euros(valor){

    return new Intl.NumberFormat(
        "es-ES",
        {
            style:"currency",
            currency:"EUR"
        }
    ).format(valor||0);

}


function escapar(texto){

    return String(texto||"")
    .replace(/[&<>"']/g,function(c){

        return {
            "&":"&amp;",
            "<":"&lt;",
            ">":"&gt;",
            '"':"&quot;",
            "'":"&#039;"
        }[c];

    });

}


/* =========================================
   NÓMINA POR FASES
========================================= */

function siguienteNomina(paso){

    document.querySelectorAll(".step")
    .forEach(s => s.classList.remove("active"));

    document.getElementById(
        "nominaStep"+paso
    ).classList.add("active");


    for(let i=1;i<=4;i++){

        const barra=document.getElementById("p"+i);

        if(i<=paso){
            barra.classList.add("active");
        }else{
            barra.classList.remove("active");
        }

    }

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

}


/* =========================================
   CALCULAR NÓMINA
========================================= */

function calcularNomina(){

    const base=numero("salarioBase");

    const pluses=

        numero("plusConvenio")+
        numero("plusAntiguedad")+
        numero("plusNocturnidad")+
        numero("plusTurnicidad")+
        numero("plusTransporte")+
        numero("dietas")+
        numero("otrosPluses")+
        numero("bonus")+
        numero("comisiones");

    const horas=

        numero("horasExtra")+
        numero("horasComplementarias")+
        numero("domingos")+
        numero("festivos")+
        numero("otrosConceptos");


    const especie=numero("salarioEspecie");

    const bruto=

        base+
        pluses+
        horas+
        especie;


    const irpfPorcentaje=numero("irpf");

    const cotizacionPorcentaje=numero("cotizacion");


    const irpf=

        bruto*
        irpfPorcentaje/
        100;


    const cotizacion=

        bruto*
        cotizacionPorcentaje/
        100;


    const descuentos=

        numero("otrosDescuentos")+
        numero("anticipos")+
        numero("embargoNomina")+
        numero("otrosDeducibles");


    const neto=

        bruto-
        irpf-
        cotizacion-
        descuentos;


    const pagas=

        parseInt(
            document.getElementById("pagas").value
        );


    const brutoAnual=

        bruto*pagas;


    const netoAnual=

        neto*pagas;


    const resultado=

    document.getElementById(
        "resultadoNomina"
    );


    resultado.classList.remove("hidden");


    resultado.innerHTML=`

        <h2>💶 Tu nómina estimada</h2>

        <div class="big-result">
            ${euros(neto)}
        </div>

        <p class="muted">
            Neto mensual estimado.
        </p>


        <div class="result-row">
            <span>Salario base</span>
            <strong>${euros(base)}</strong>
        </div>


        <div class="result-row">
            <span>Pluses y complementos</span>
            <strong>${euros(pluses)}</strong>
        </div>


        <div class="result-row">
            <span>Horas / domingos / festivos</span>
            <strong>${euros(horas)}</strong>
        </div>


        <div class="result-row">
            <span>Salario en especie</span>
            <strong>${euros(especie)}</strong>
        </div>


        <div class="result-row">
            <span>💰 Bruto mensual</span>
            <strong>${euros(bruto)}</strong>
        </div>


        <div class="result-row">
            <span>Cotización (${cotizacionPorcentaje}%)</span>
            <strong>-${euros(cotizacion)}</strong>
        </div>


        <div class="result-row">
            <span>IRPF (${irpfPorcentaje}%)</span>
            <strong>-${euros(irpf)}</strong>
        </div>


        <div class="result-row">
            <span>Otros descuentos</span>
            <strong>-${euros(descuentos)}</strong>
        </div>


        <div class="result-row">
            <span>Bruto anual estimado</span>
            <strong>${euros(brutoAnual)}</strong>
        </div>


        <div class="result-row">
            <span>Neto anual estimado</span>
            <strong>${euros(netoAnual)}</strong>
        </div>


        <details>

            <summary>
                🔎 Ver cómo se ha calculado
            </summary>

            <p>
                El bruto estimado se obtiene sumando el salario base,
                pluses, horas, bonus, complementos y salario en especie
                introducidos.
            </p>

            <p>
                Después se restan las cotizaciones, IRPF y descuentos
                introducidos.
            </p>

            <p>
                Los porcentajes utilizados son los que has indicado.
            </p>

        </details>


        <div class="notice">

            ⚠️ <strong>Estimación:</strong>
            esta cantidad no sustituye a una nómina real.
            Algunos conceptos pueden tener un tratamiento diferente
            a efectos de cotización o fiscalidad.

        </div>
    `;

}


