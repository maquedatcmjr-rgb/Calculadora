<script>


/* =========================
   NAVEGACIÓN
========================= */

function mostrar(id,boton){

document.querySelectorAll("main section")
.forEach(s=>s.classList.add("hidden"));

document.getElementById(id)
.classList.remove("hidden");

document.querySelectorAll("nav button")
.forEach(b=>b.classList.remove("active"));

boton.classList.add("active");

window.scrollTo({
top:0,
behavior:"smooth"
});

}


/* =========================
   PASOS NÓMINA
========================= */

function paso(numero){

document.querySelectorAll(".step")
.forEach(s=>s.classList.remove("active"));

document.getElementById("step"+numero)
.classList.add("active");

for(let i=1;i<=4;i++){

const barra=
document.getElementById("bar"+i);

if(i<=numero)
barra.classList.add("active");
else
barra.classList.remove("active");

}

}


/* =========================
   OBTENER NÚMERO
========================= */

function n(id){

return parseFloat(
document.getElementById(id)?.value
)||0;

}


/* =========================
   EUROS
========================= */

function euros(valor){

return new Intl.NumberFormat(
"es-ES",
{
style:"currency",
currency:"EUR"
}
).format(valor||0);

}


/* =========================
   NÓMINA
========================= */

function calcularNomina(){

const base=n("base");

const pluses=

n("plusConvenio")+
n("antiguedadPlus")+
n("nocturnidad")+
n("turnicidad")+
n("transporte")+
n("dietas")+
n("bonus")+
n("comisiones")+
n("otrosPluses");

const variables=

n("horasExtra")+
n("horasComplementarias")+
n("domingos")+
n("festivos")+
n("bonusExtra")+
n("otros");

const especie=n("especie");

const bruto=
base+
pluses+
variables+
especie;

const porcentajeIRPF=n("irpf");

const porcentajeSS=n("ss");

const irpf=
bruto*
porcentajeIRPF/
100;

const seguridadSocial=
bruto*
porcentajeSS/
100;

const descuentos=
n("descuentos")+
n("anticipos")+
n("embargo");

const neto=
bruto-
irpf-
seguridadSocial-
descuentos;

const pagas=
parseInt(
document.getElementById("pagas").value
);

const brutoAnual=
bruto*pagas;

const resultado=
document.getElementById(
"resultadoNomina"
);

resultado.classList.remove("hidden");

resultado.innerHTML=`

<h2>
💶 Resultado estimado
</h2>

<div class="big">
${euros(neto)}
</div>

<p>
<strong>Neto mensual estimado</strong>
</p>

<div class="result-row">
<span>Salario base</span>
<strong>${euros(base)}</strong>
</div>

<div class="result-row">
<span>Pluses</span>
<strong>${euros(pluses)}</strong>
</div>

<div class="result-row">
<span>Horas y variables</span>
<strong>${euros(variables)}</strong>
</div>

<div class="result-row">
<span>Salario en especie</span>
<strong>${euros(especie)}</strong>
</div>

<div class="result-row">
<span>Bruto mensual</span>
<strong>${euros(bruto)}</strong>
</div>

<div class="result-row">
<span>Seguridad Social (${porcentajeSS}%)</span>
<strong>-${euros(seguridadSocial)}</strong>
</div>

<div class="result-row">
<span>IRPF (${porcentajeIRPF}%)</span>
<strong>-${euros(irpf)}</strong>
</div>

<div class="result-row">
<span>Otros descuentos</span>
<strong>-${euros(descuentos)}</strong>
</div>

<div class="result-row">
<span>Bruto anual aproximado</span>
<strong>${euros(brutoAnual)}</strong>
</div>

<details>

<summary>
🔎 Ver explicación
</summary>

<p>
La calculadora suma los conceptos introducidos y resta
las retenciones y descuentos que hayas indicado.
</p>

<p>
El tratamiento real de cada concepto puede variar.
</p>

</details>

<div class="notice">

⚠️ Este resultado es una estimación y no constituye una nómina oficial.

</div>

`;

}


/* =========================
   EMBARGO
========================= */

function calcularEmbargo(){

const neto=n("netoEmbargo");

const protegido=n("protegido");

if(neto<=0){

alert("Introduce el salario neto.");

return;

}

const exceso=
Math.max(
0,
neto-protegido
);

let embargo=0;

let restante=exceso;


/*
Escala simplificada orientativa.

Debe actualizarse conforme a la normativa
antes de utilizarse como cálculo jurídico.
*/

const tramos=[
.30,
.50,
.60,
.75,
.90
];

for(
let i=0;
i<tramos.length && restante>0;
i++
){

const tramo=
Math.min(
restante,
protegido
);

embargo+=
tramo*
tramos[i];

restante-=tramo;

}

const queda=
neto-embargo;

const resultado=
document.getElementById(
"resultadoEmbargo"
);

resultado.classList.remove("hidden");

resultado.innerHTML=`

<h2>
🔒 Embargo estimado
</h2>

<div class="big">
${euros(embargo)}
</div>

<div class="result-row">
<span>Neto antes del embargo</span>
<strong>${euros(neto)}</strong>
</div>

<div class="result-row">
<span>Referencia protegida</span>
<strong>${euros(protegido)}</strong>
</div>

<div class="result-row">
<span>Embargo estimado</span>
<strong>${euros(embargo)}</strong>
</div>

<div class="result-row">
<span>Importe restante aproximado</span>
<strong>${euros(queda)}</strong>
</div>

<div class="notice">

⚠️ Estimación.
La cantidad oficial puede variar según el tipo de deuda,
la resolución y la normativa aplicable.

</div>

`;

}


/* =========================
   FINIQUITO
========================= */

function calcularFiniquito(){

const salario=n("salarioFin");

let anual=n("salarioAnual");

if(anual<=0)
anual=salario*12;

const diario=
salario/30;

const dias=
n("diasPendientes");

const salarioPendiente=
diario*dias;

const vacaciones=
n("vacaciones");

const disfrutadas=
n("vacacionesDisfrutadas");

const pendientes=
Math.max(
0,
vacaciones-disfrutadas
);

const importeVacaciones=
diario*pendientes;

const extras=
n("extrasPendientes");

const finiquito=
salarioPendiente+
importeVacaciones+
extras;

const antiguedad=
n("anosAntiguedad");

const diasAno=
n("diasPorAno");

const indemnizacion=
(
anual/
365
)*
diasAno*
antiguedad;

const total=
finiquito+
indemnizacion;

const resultado=
document.getElementById(
"resultadoFiniquito"
);

resultado.classList.remove("hidden");

resultado.innerHTML=`

<h2>
📄 Resultado estimado
</h2>

<div class="big">
${euros(total)}
</div>

<h3>
Finiquito
</h3>

<div class="result-row">
<span>Salario pendiente</span>
<strong>${euros(salarioPendiente)}</strong>
</div>

<div class="result-row">
<span>Vacaciones pendientes</span>
<strong>${euros(importeVacaciones)}</strong>
</div>

<div class="result-row">
<span>Pagas extra pendientes</span>
<strong>${euros(extras)}</strong>
</div>

<div class="result-row">
<span>Total finiquito</span>
<strong>${euros(finiquito)}</strong>
</div>

<h3>
Indemnización orientativa
</h3>

<div class="result-row">
<span>Antigüedad</span>
<strong>${antiguedad} años</strong>
</div>

<div class="result-row">
<span>Días por año introducidos</span>
<strong>${diasAno}</strong>
</div>

<div class="result-row">
<span>Indemnización</span>
<strong>${euros(indemnizacion)}</strong>
</div>

<div class="notice">

⚠️ El cálculo de indemnización requiere comprobar
el supuesto legal concreto. Introducir un número de días
por año no significa que ese régimen sea necesariamente
el aplicable a tu caso.

</div>

`;

}


/* =========================
   GUARDAR
========================= */

function guardar(){

const datos={};

document
.querySelectorAll(
"#nomina input,#nomina select"
)
.forEach(e=>{
datos[e.id]=e.value;
});

localStorage.setItem(
"cuentaclaro",
JSON.stringify(datos)
);

alert(
"Tu cálculo se ha guardado en este dispositivo."
);

}


/* =========================
   RECUPERAR
========================= */

window.addEventListener(
"DOMContentLoaded",
()=>{

const guardado=
localStorage.getItem(
"cuentaclaro"
);

if(!guardado)
return;

try{

const datos=
JSON.parse(guardado);

Object.entries(datos)
.forEach(([id,valor])=>{

const elemento=
document.getElementById(id);

if(elemento)
elemento.value=valor;

});

}catch(e){}

}
);

</script>

</body>
</html>
