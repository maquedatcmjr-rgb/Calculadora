header{
background:linear-gradient(135deg,#2563eb,#4f8cff);
color:white;
padding:30px 18px 75px;
}

.header{
max-width:1100px;
margin:auto;
}

.logo{
font-size:30px;
font-weight:900;
}

.slogan{
opacity:.9;
}

main{
max-width:1100px;
margin:-45px auto 60px;
padding:0 15px;
}

nav{
display:flex;
gap:8px;
overflow-x:auto;
padding:10px 0 18px;
}

nav button{
border:1px solid var(--border);
background:white;
border-radius:999px;
padding:11px 16px;
font-weight:700;
white-space:nowrap;
cursor:pointer;
}

nav button.active{
background:var(--primary);
color:white;
border-color:var(--primary);
}

.card{
background:white;
border:1px solid var(--border);
border-radius:var(--radius);
padding:22px;
margin-bottom:18px;
box-shadow:var(--shadow);
}

.hero h1{
font-size:clamp(26px,6vw,40px);
line-height:1.1;
margin:0 0 12px;
}

.hero p{
color:var(--muted);
}

.notice{
background:#fff8df;
border:1px solid #efd36a;
border-radius:14px;
padding:14px;
color:#654d00;
margin-top:18px;
}

.grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:15px;
}

.grid3{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:15px;
}

label{
font-weight:700;
font-size:14px;
}

label small{
display:block;
color:var(--muted);
font-weight:400;
margin-top:4px;
}

input,
select{
width:100%;
padding:12px;
margin-top:7px;
border:1px solid var(--border);
border-radius:12px;
font-size:16px;
background:white;
}

input:focus,
select:focus{
outline:3px solid #dbeafe;
border-color:var(--primary);
}

.actions{
display:flex;
flex-wrap:wrap;
gap:10px;
margin-top:20px;
}

.btn{
border:0;
border-radius:13px;
padding:13px 18px;
font-weight:800;
cursor:pointer;
}

.primary{
background:var(--primary);
color:white;
}

.secondary{
background:#edf2f7;
color:var(--text);
}

.danger{
background:#fff0f0;
color:var(--danger);
}

.result{
background:var(--primary-light);
border:1px solid #bfdbfe;
border-radius:17px;
padding:20px;
margin-top:20px;
}

.big{
font-size:38px;
font-weight:900;
color:var(--primary);
}

.result-row{
display:flex;
justify-content:space-between;
gap:15px;
padding:10px 0;
border-bottom:1px dashed #cbd5e1;
}

.result-row:last-child{
border-bottom:0;
}

.hidden{
display:none!important;
}

.progress{
display:flex;
gap:7px;
margin-bottom:20px;
}

.progress div{
height:7px;
flex:1;
background:#e2e8f0;
border-radius:20px;
}

.progress .active{
background:var(--primary);
}

.step{
display:none;
}

.step.active{
display:block;
}

.ad{
min-height:100px;
border:1px dashed #cbd5e1;
background:#fafcff;
border-radius:15px;
display:flex;
align-items:center;
justify-content:center;
color:#8a94a5;
margin:20px 0;
font-size:13px;
}

.ad-label{
text-align:center;
}

.official-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:12px;
}

.official{
display:block;
text-decoration:none;
color:var(--text);
background:#f8fafc;
border:1px solid var(--border);
border-radius:15px;
padding:16px;
transition:.2s;
}

.official:hover{
border-color:var(--primary);
background:#eff6ff;
transform:translateY(-2px);
}

.official strong{
display:block;
color:var(--primary);
margin-bottom:4px;
}

.official span{
font-size:13px;
color:var(--muted);
}

details{
border:1px solid var(--border);
border-radius:13px;
padding:13px;
margin-top:15px;
background:#fafbfd;
}

summary{
cursor:pointer;
font-weight:800;
}

footer{
max-width:1100px;
margin:auto;
padding:0 15px 50px;
color:var(--muted);
font-size:14px;
}

footer a{
color:var(--primary);
}

@media(max-width:700px){

.grid,
.grid3,
.official-grid{
grid-template-columns:1fr;
}

.card{
padding:17px;
}

.actions .btn{
width:100%;
}

}

@media print{

header,
nav,
.actions,
.ad,
footer{
display:none!important;
}

body{
background:white;
}

main{
margin:0;
max-width:none;
}

.card{
box-shadow:none;
border:0;
}

}

</style>

